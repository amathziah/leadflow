# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------
# `docker compose up -d db` starts a local Postgres matching this URL.
# Any Postgres instance works — Supabase, Neon, RDS, or your own.
DATABASE_URL="postgresql://leadflow:leadflow@localhost:5432/leadflow"

# ---------------------------------------------------------------------------
# AI (required for research, enrichment, signal detection and copywriting)
# ---------------------------------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# Without this the deterministic stages (ICP qualification, scoring, the review
# state machine) still work; every AI stage falls back to a template and says so.
GEMINI_API_KEY=""

# Model aliases, overridable for reproducible runs. Defaults track the current
# generation on purpose: this project previously pinned `gemini-2.0-flash`,
# Google retired it, and every AI stage failed silently into its fallback.
# GEMINI_FAST_MODEL="gemini-flash-latest"
# GEMINI_DEEP_MODEL="gemini-pro-latest"

# ---------------------------------------------------------------------------
# Outbound email (optional)
# ---------------------------------------------------------------------------
# Without SMTP, LeadFlow never sends anything: approved drafts are copied or
# exported from the review screen and you send them yourself.
# Gmail: use an App Password (https://myaccount.google.com/apppasswords),
# not your account password. Works equally with SendGrid, Mailgun, Postmark, SES.
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Your Name <you@yourdomain.com>"

# ---------------------------------------------------------------------------
# Browser automation (optional — used for website research)
# ---------------------------------------------------------------------------
# 'local' launches its own headless Chromium; 'cdp' attaches to a Chrome you
# are already running on CHROME_CDP_PORT.
BROWSER_MODE=local
CHROME_CDP_PORT=9222

# ---------------------------------------------------------------------------
# Remote file storage (optional)
# ---------------------------------------------------------------------------
# Only used to store research screenshots off-box. When unset, screenshots are
# written to backend/logs/screenshots and served from /screenshots.
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_SCREENSHOTS_BUCKET="leadflow-screenshots"
SUPABASE_LOGS_BUCKET="leadflow-logs"

# ---------------------------------------------------------------------------
# Default workspace identity (optional)
# ---------------------------------------------------------------------------
DEFAULT_ORG_NAME="My Company"
DEFAULT_ORG_DOMAIN="mycompany.com"
DEFAULT_USER_EMAIL="me@mycompany.com"
DEFAULT_USER_NAME="Me"
